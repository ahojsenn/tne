[Unit]
Description=TNE-Server
After=network.target

[Service]
Type=simple
User=hannes

# Both paths go through the `current` symlink, which release.sh swaps
# atomically. systemd resolves the symlink at start, so a restart always picks
# up whichever release is live at that moment — and nothing here has to change
# when a new release is deployed.
WorkingDirectory=/home/hannes/tne/current
ExecStart=/home/hannes/.nvm/versions/node/v20.12.0/bin/node /home/hannes/tne/current/.output/server/index.mjs

# Nitro already inlines NODE_ENV=production when building .output, but several
# code paths read it at runtime (prod spreadsheet, SITE_URL, disabling the
# test-* endpoints, reset rate limits). Set it explicitly rather than relying on
# a build-time substitution.
Environment=NODE_ENV=production

# Listen on loopback only. Nitro otherwise binds 0.0.0.0 and ::, which made
# http://konfi.kommitment.works:3000 serve the whole site straight from the
# internet: no TLS, no HTTP->HTTPS redirect, and a speaker login posting its
# password in the clear. nginx is the only thing that should reach the app.
#
# `ufw deny 3000` is in bootstrap.sh and was evidently not in force, so this
# does not rely on the firewall: the socket simply is not there to connect to.
Environment=HOST=127.0.0.1

# Secrets are NOT set here. Each release dir carries a .env symlink to
# /home/hannes/tne/shared/.env, which the app's envCheck nitro plugin loads at
# startup. That keeps the 1734-character service-account key out of systemd's
# environment-file escaping rules, and keeps secrets off CI entirely.

Restart=on-failure
RestartSec=5

# journald, not a file in /tmp. The previous append:/tmp/tne.log grew without
# rotation and was wiped on reboot; journald on this box writes to
# /var/log/journal, so it survives restarts and is vacuumed automatically.
#   journalctl -u tne.service -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tne

# The app logs a line per throw, and a busy game is exactly when the logs
# matter. journald's default of 10000 messages per 30s would silently drop
# them mid-event, so raise the ceiling for this unit.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30000

[Install]
WantedBy=multi-user.target
