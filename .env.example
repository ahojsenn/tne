# Session secret for speaker auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_session_secret_here

# Public base URL for links in confirmation / password-reset emails (no trailing slash).
# Production only — deploy.sh copies this file to the server verbatim, so do NOT
# repoint it for local work.
SITE_URL=https://konfi.kommitment.works

# Optional override used when NODE_ENV != production. Leave unset and locally
# generated links follow the request host (http://localhost:3000); set it only
# when the server is reached through a tunnel, e.g. an ngrok URL.
# SITE_URL_DEV=http://localhost:3000

# Optional: password-reset rate limits per 15 min window.
# Defaults: 3 per email / 15 per IP in production, 100 each otherwise.
# RESET_LIMIT_PER_EMAIL=3
# RESET_LIMIT_PER_IP=15

# Mail is only delivered when NODE_ENV=production. Locally the links are logged
# and kept in memory for the e2e suite instead, so test runs never bounce mail
# off @test.example addresses. Set this to 1 to really deliver from a dev server.
# MAIL_DEV_SEND=1

# SMTP for confirmation emails (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your@gmail.com

# Google Sheets integration
# Spreadsheet ID from the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_production_spreadsheet_id_here

# Optional: separate spreadsheet for local development (NODE_ENV != production)
# Falls back to GOOGLE_SHEETS_SPREADSHEET_ID if not set
GOOGLE_SHEETS_SPREADSHEET_ID_DEV=your_dev_spreadsheet_id_here

# Service account credentials (from the downloaded JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value here — keep the quotes and use \n for newlines
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"

# Local dev fallback: set this to bypass Google Sheets config for auth
# On production the password is loaded from the Google Sheet "config" tab instead
# ADMIN_PASSWORD=your_local_dev_password
